# Sends every request that isn't a file in public/ to public/index.php.
#
# nginx's entrypoint fills in ${SIGHTPRESS_BODY_LIMIT} and ${UPLOAD_TIMEOUT} from .env (docker/limits.sh), the same
# values PHP gets, and writes the result to /etc/nginx/conf.d/default.conf.
server {
    listen 80 default_server;
    server_name _;
    root /app/public;

    server_tokens off;

    # Requests as large as PHP's post_max_size; a larger one gets SightPress's own "too large" page, not nginx's.
    client_max_body_size ${SIGHTPRESS_BODY_LIMIT};
    client_body_timeout ${UPLOAD_TIMEOUT}s;
    error_page 413 /_sightpress/request-too-large;

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        fastcgi_pass php:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_read_timeout ${UPLOAD_TIMEOUT}s;
    }

    # Only reached from error_page 413: PHP gets a GET for this address, without the refused body.
    location = /_sightpress/request-too-large {
        internal;
        fastcgi_pass php:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_param REQUEST_METHOD GET;
        fastcgi_param REQUEST_URI /_sightpress/request-too-large;
        fastcgi_param QUERY_STRING "";
        fastcgi_param CONTENT_TYPE "";
        fastcgi_param CONTENT_LENGTH "";
    }

    location ~ \.php$ {
        return 404;
    }
}
