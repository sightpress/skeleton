{
  "name": "sightpress/skeleton",
  "description": "Start a new SightPress project: a powerful multi-site, multilingual CMS for everyone, designed with blind and low-vision creators and audiences in mind. Built on modern, object-oriented PHP.",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "cms",
    "accessibility",
    "a11y",
    "wcag",
    "skeleton"
  ],
  "homepage": "https://sightpress.org",
  "support": {
    "issues": "https://github.com/sightpress/skeleton/issues",
    "source": "https://github.com/sightpress/skeleton"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../module-interface",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": ">=8.5",
    "sightpress/core": "^0.1@dev"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3",
    "phpstan/extension-installer": "^1",
    "phpstan/phpstan": "^2",
    "phpstan/phpstan-phpunit": "^2",
    "phpstan/phpstan-strict-rules": "^2",
    "phpunit/phpunit": "^13",
    "rector/rector": "^2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "cs-check": "php-cs-fixer check --diff",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse --no-progress",
    "rector": "rector process",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:coverage": "@php tools/coverage-check.php",
    "check": [
      "@composer validate --strict --no-check-lock",
      "@cs-check",
      "@phpstan",
      "@test:coverage",
      "@test:integration"
    ],
    "fix": [
      "@rector",
      "@cs-fix"
    ],
    "up": "docker compose up --detach --wait",
    "down": "docker compose down",
    "site:create": "@php bin/sightpress site:create"
  },
  "scripts-descriptions": {
    "cs-check": "Check the code style (PSR-12) without changing files.",
    "cs-fix": "Fix the code style (PSR-12).",
    "phpstan": "Run static analysis (PHPStan, level max).",
    "rector": "Apply automated refactorings (PHP 8.5 set).",
    "test": "Run the unit and integration test suites.",
    "test:unit": "Run the unit test suite.",
    "test:integration": "Run the integration test suite.",
    "test:coverage": "Run the unit suite with coverage; fail below 100% lines or methods or on any coverage ignore annotation.",
    "check": "Run every check that must pass before a commit.",
    "fix": "Apply Rector refactorings, then fix the code style.",
    "up": "Start the local environment (http://localhost:8080) in the background.",
    "down": "Stop the local environment.",
    "site:create": "Create a site, for example `composer site:create demo` (not available yet)."
  }
}
