#!/usr/bin/env php
<?php

declare(strict_types=1);

use SightPress\Core\Kernel;

require dirname(__DIR__) . '/vendor/autoload.php';

// The console of SightPress: every module's commands (`bin/sightpress list` shows them).
try {
    $console = Kernel::boot(dirname(__DIR__))->console();
} catch (Throwable $exception) {
    fwrite(STDERR, sprintf("SightPress could not start: %s\n", $exception->getMessage()));
    exit(1);
}

exit($console->run());
