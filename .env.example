# Copy this file to .env and change what you need. Never commit .env.
# Every value below is a safe default for local development.

# Environment: production, staging, dev or test. Anything but production asks search engines not to index pages.
APP_ENV=dev

# E-mail (Mailpit catches everything locally; web UI on http://localhost:8025)
MAILER_DSN=smtp://mailpit:1025

# Object storage (MinIO; console on http://localhost:9001)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sightpress
MINIO_ROOT_USER=sightpress
MINIO_ROOT_PASSWORD=sightpress-secret

# Optional database containers (docker compose --profile mysql|mariadb|postgres)
DB_NAME=sightpress
DB_USER=sightpress
DB_PASSWORD=sightpress
DB_ROOT_PASSWORD=sightpress-root

# Ports on your computer (127.0.0.1 only)
HTTP_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# User and group the PHP container runs as, so files it writes belong to you (see `id -u` and `id -g`).
UID=1000
GID=1000
