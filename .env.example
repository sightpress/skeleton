# Copy this file to .env and change what you need. Never commit .env.
# Every value below is a safe default for local development.

# Working on SightPress itself, with core and module-interface cloned next to this project? Uncomment this line so
# the PHP container uses those checkouts (see docker-compose.siblings.yml).
#COMPOSE_FILE=docker-compose.yml:docker-compose.siblings.yml

# Environment: production, staging, dev or test. Anything but production asks search engines not to index pages.
APP_ENV=dev

# Encrypts each site's database address in config/sites.php: at least 32 random characters. Make one with
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# and keep a copy somewhere safe: without it the sites can't reach their databases.
APP_SECRET=

# E-mail (Mailpit catches everything locally; web UI on http://localhost:8025)
MAILER_DSN=smtp://mailpit:1025

# Object storage (MinIO; console on http://localhost:9001)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sightpress
MINIO_ROOT_USER=sightpress
MINIO_ROOT_PASSWORD=sightpress-secret

# Upload and input limits. One block sets PHP and nginx together, so they can't drift apart (docker/limits.sh).
# Sizes are whole megabytes or gigabytes (64M, 1G). The values below are the recommended "standard" ones.
#   UPLOAD_MAX_SIZE   largest file in one request (PHP upload_max_filesize; post_max_size and nginx
#                     client_max_body_size get 1M more for the rest of the form)
#   INPUT_MAX_SIZE    largest form without files, such as a long page in the block editor
#   INPUT_MAX_VARS    fields in one form (PHP max_input_vars; below 5000 a long page can lose content when saved)
#   MAX_FILE_UPLOADS  files in one request
#   PHP_MEMORY_LIMIT  memory for one request; 256M resizes pictures of up to 25 million pixels, 512M up to 50
#   UPLOAD_TIMEOUT    seconds a slow upload may take
# Small site or shared hosting: UPLOAD_MAX_SIZE=32M. Media-heavy sites: PHP_MEMORY_LIMIT=512M (larger pictures).
# Restart after a change (docker compose up -d), then check with: docker compose exec php bin/sightpress system:check
# Each site can have its own file limits (bin/sightpress site:media:limits). To see the values they need here:
#   docker compose exec php bin/sightpress system:check --recommend
UPLOAD_MAX_SIZE=64M
INPUT_MAX_SIZE=8M
INPUT_MAX_VARS=5000
MAX_FILE_UPLOADS=20
PHP_MEMORY_LIMIT=256M
UPLOAD_TIMEOUT=300

# Optional database containers (docker compose --profile mysql|mariadb|postgres)
DB_NAME=sightpress
DB_USER=sightpress
DB_PASSWORD=sightpress
DB_ROOT_PASSWORD=sightpress-root

# Ports on your computer (127.0.0.1 only)
HTTP_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# User and group the PHP container runs as, so files it writes belong to you (see `id -u` and `id -g`).
UID=1000
GID=1000
